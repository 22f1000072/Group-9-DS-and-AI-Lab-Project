{
  "name": "B_noisy",
  "init_model": "facebook/wav2vec2-base",
  "augment": true,
  "p_clean": 0.2,
  "snr_min": 0.0,
  "snr_max": 20.0,
  "max_steps": 36000,
  "lr": 5e-05,
  "warmup_ratio": 0.08,
  "weight_decay": 0.005,
  "max_grad_norm": 1.0,
  "max_batch_seconds": 640,
  "grad_accum": 1,
  "eval_every": 2000,
  "save_every": 2000,
  "log_every": 50,
  "num_workers": 28,
  "seed": 42,
  "mask_time_prob": 0.4,
  "mask_time_length": 10,
  "mask_feature_prob": 0.1,
  "mask_feature_length": 64,
  "layerdrop": 0.1,
  "attention_dropout": 0.1,
  "hidden_dropout": 0.1,
  "feat_proj_dropout": 0.0,
  "final_dropout": 0.0,
  "freeze_feature_encoder": true,
  "eval_max_seconds": 600.0,
  "max_train_utts": null
}